#!/bin/sh
# Git commit-msg hook to enforce Conventional Commits format:
# <type>(<scope>): <subject>
# or
# <type>: <subject>

COMMIT_MSG_FILE="$1"
FIRST_LINE=$(head -n 1 "$COMMIT_MSG_FILE")

# Allow merge, squash, and revert commits generated by git
if echo "$FIRST_LINE" | grep -qE '^(Merge|Revert|Squash|Apply) '; then
    exit 0
fi

# Check maximum line length of 72 characters
LENGTH=$(echo -n "$FIRST_LINE" | wc -m)
if [ "$LENGTH" -gt 72 ]; then
    echo "ERROR: Commit subject line is too long ($LENGTH chars). Maximum allowed is 72 chars."
    echo "Subject: $FIRST_LINE"
    exit 1
fi

# Check no trailing period
if echo "$FIRST_LINE" | grep -qE '\.$'; then
    echo "ERROR: Commit subject line must not end with a period."
    echo "Subject: $FIRST_LINE"
    exit 1
fi

# Validate Conventional Commits format:
# type: feat, fix, refactor, perf, style, test, chore, docs
# scope: optional (lowercase, numbers, hyphen, underscore)
# subject: must start with a lowercase letter or digit
PATTERN="^(feat|fix|refactor|perf|style|test|chore|docs)(\([a-z0-9_/-]+\))?: [a-z0-9].+$"

if ! echo "$FIRST_LINE" | grep -qE "$PATTERN"; then
    echo "ERROR: Invalid commit message format."
    echo "Commit message must follow Conventional Commits:"
    echo "  <type>(<scope>): <subject>"
    echo "  or"
    echo "  <type>: <subject>"
    echo ""
    echo "Allowed types: feat, fix, refactor, perf, style, test, chore, docs"
    echo "Example: feat(dashboard): add transaction summary card"
    echo "Your message was:"
    echo "  $FIRST_LINE"
    exit 1
fi

exit 0
