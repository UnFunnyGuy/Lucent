#!/bin/sh
# Git pre-commit hook to format staged Kotlin files with Spotless

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(kt|kts)$')

if [ -n "$STAGED_FILES" ]; then
    echo "Formatting staged Kotlin files with Spotless..."
    ./gradlew spotlessApply -q --no-daemon
    STATUS=$?

    if [ $STATUS -ne 0 ]; then
        echo "Spotless formatting failed. Please resolve errors before committing."
        exit $STATUS
    fi

    echo "$STAGED_FILES" | while IFS= read -r file; do
        if [ -f "$file" ]; then
            git add "$file"
        fi
    done
    echo "Formatting complete and files re-staged."
fi

exit 0
